<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileConvert.ViewModels"
        xmlns:models="using:FileConvert.Models"
        xmlns:local="using:FileConvert.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1060" d:DesignHeight="720"
        Width="1060" Height="720"
        MinWidth="900" MinHeight="600"
        x:Class="FileConvert.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/TypeConvert_Logo.ico"
        Title="FileConvert"
        CanResize="True"
        Background="{DynamicResource ThemeWindowBg}"
        KeyDown="OnWindowKeyDown">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>

        <!-- ══ ICON BUTTONS (header) ══ -->
        <Style Selector="Button.iconBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.iconBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeChipBg}"/>
        </Style>

        <!-- ══ NAVIGATION BUTTONS (left sidebar) ══ -->
        <Style Selector="Button.navBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#3a3e6a"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="CornerRadius"    Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="{StaticResource NunitoFont}"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>
        <Style Selector="Button.navBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
        </Style>
        <Style Selector="Button.navBtn.batchActive">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentLight}"/>
        </Style>
        <Style Selector="Button.navBtn.batchActive /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemePanelTabActiveBg}"/>
        </Style>
        <Style Selector="Button.navBtn.batchActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeChipActiveBgHover}"/>
        </Style>

        <!-- ══ MEDIA CARD BUTTONS (IMAGE / AUDIO / VIDEO) ══ -->
        <Style Selector="Button.mediaCard">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#3a3e6a"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush"     Value="#1e2140"/>
            <Setter Property="MinHeight"       Value="90"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="{StaticResource NunitoFont}"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>
        <Style Selector="Button.mediaCard /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeChipBg}"/>
        </Style>
        <Style Selector="Button.mediaCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeChipHover}"/>
        </Style>
        <Style Selector="Button.mediaCard:disabled">
            <Setter Property="Opacity" Value="0.28"/>
        </Style>

        <!-- IMAGE card — active: theme accent (cyan for Indigo theme) -->
        <Style Selector="Button.mediaCard.mediaCardImage.tabActive">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Foreground"  Value="{DynamicResource ThemeAccentLight}"/>
        </Style>
        <Style Selector="Button.mediaCard.mediaCardImage.tabActive /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeChipActiveBg}"/>
        </Style>
        <Style Selector="Button.mediaCard.mediaCardImage.tabActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeChipActiveBgHover}"/>
        </Style>

        <!-- AUDIO card — active: deep crimson -->
        <Style Selector="Button.mediaCard.mediaCardAudio.tabActive">
            <Setter Property="BorderBrush" Value="#c41e3a"/>
            <Setter Property="Foreground"  Value="#ff8090"/>
        </Style>
        <Style Selector="Button.mediaCard.mediaCardAudio.tabActive /template/ ContentPresenter">
            <Setter Property="Background" Value="#280810"/>
        </Style>
        <Style Selector="Button.mediaCard.mediaCardAudio.tabActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#340c16"/>
        </Style>

        <!-- VIDEO card — active: royal purple -->
        <Style Selector="Button.mediaCard.mediaCardVideo.tabActive">
            <Setter Property="BorderBrush" Value="#7c3aed"/>
            <Setter Property="Foreground"  Value="#c4b5fd"/>
        </Style>
        <Style Selector="Button.mediaCard.mediaCardVideo.tabActive /template/ ContentPresenter">
            <Setter Property="Background" Value="#18082e"/>
        </Style>
        <Style Selector="Button.mediaCard.mediaCardVideo.tabActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1e0c38"/>
        </Style>

        <!-- ══ FORMAT CHIP BUTTONS ══ -->
        <Style Selector="Button.fmtChip">
            <Setter Property="Background"      Value="{DynamicResource ThemeChipBg}"/>
            <Setter Property="Foreground"      Value="#464a78"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Margin"          Value="3,3"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="{StaticResource NunitoFont}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>
        <Style Selector="Button.fmtChip /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeChipBg}"/>
        </Style>
        <Style Selector="Button.fmtChip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeChipHover}"/>
        </Style>
        <Style Selector="Button.fmtChip.fmtActive">
            <Setter Property="Foreground"      Value="{DynamicResource ThemeAccentLight}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="Button.fmtChip.fmtActive /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeChipActiveBg}"/>
        </Style>
        <Style Selector="Button.fmtChip.fmtActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeChipActiveBgHover}"/>
        </Style>

        <!-- ══ MINI BUTTONS ══ -->
        <Style Selector="Button.miniBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#3a3e6a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#1c1f40"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="{StaticResource NunitoFont}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>
        <Style Selector="Button.miniBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.miniBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeChipBg}"/>
        </Style>

        <!-- ══ METADATA TEXT ══ -->
        <Style Selector="TextBlock.metaKey">
            <Setter Property="FontSize"      Value="9"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="Foreground"    Value="#323660"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.metaVal">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="Foreground"        Value="#666a98"/>
            <Setter Property="FontFamily"        Value="{StaticResource NunitoFont}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping"      Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.sectionHdr">
            <Setter Property="FontSize"      Value="9"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="Foreground"    Value="#3a4070"/>
            <Setter Property="LetterSpacing" Value="2"/>
        </Style>

        <!-- ══ CARD BORDER ══ -->
        <Style Selector="Border.card">
            <Setter Property="Background"      Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow"       Value="0 2 20 0 #2c000014"/>
        </Style>

        <!-- ══ LISTBOX ITEMS ══ -->
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding"    Value="8,4"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeListItemSelected}"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
        </Style>

    </Window.Styles>

    <!--
    ══════════════════════════════════════════════════════════
      ROOT  Row 0: Header (54)  Row 1: Content (*)  Row 2: Footer (78)
    ══════════════════════════════════════════════════════════
    -->
    <Grid RowDefinitions="54, *, 78">

        <!-- ═══════════════════════════════════════════════ -->
        <!--  ROW 0 — Header                                 -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}"
              ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto, Auto">

            <!-- Logo + title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="18,0,0,0" Spacing="10">
                <Image Source="/Assets/TypeConvert_Logo.ico" Width="20" Height="20" VerticalAlignment="Center"/>
                <TextBlock Text="FileConvert"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#e0e4ff"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource NunitoFont}"/>
            </StackPanel>

            <Border Grid.Column="1"/>

            <!-- Version badge -->
            <Border Grid.Column="2"
                    Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="9,3" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="v0.5"
                           Foreground="#2e3868" FontSize="9" FontWeight="SemiBold"
                           FontFamily="{StaticResource NunitoFont}"/>
            </Border>

            <!-- Theme toggle -->
            <Button Grid.Column="3"
                    Click="OnAppearanceButtonClicked"
                    Classes="iconBtn" ToolTip.Tip="Appearance"
                    VerticalAlignment="Center" Margin="0,0,2,0">
                <TextBlock Text="◑" FontSize="15" Foreground="#484c7a"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>

            <Border Grid.Column="4" Width="1" Background="#181b3a" Margin="4,12,6,12"/>

            <!-- Settings -->
            <Button Grid.Column="5"
                    Command="{Binding OpenSettingsSelectCommand}"
                    Classes="iconBtn" ToolTip.Tip="Settings"
                    VerticalAlignment="Center" Margin="0,0,2,0">
                <Image Source="/Assets/SettingsIcon.png" Width="16" Height="16"/>
            </Button>

            <!-- GitHub -->
            <Button Grid.Column="6"
                    Click="OnGithubButtonClicked"
                    Classes="iconBtn" ToolTip.Tip="GitHub"
                    VerticalAlignment="Center" Margin="0,0,10,0">
                <Image Source="/Assets/Github.png" Width="16" Height="16"/>
            </Button>
        </Grid>

        <Border Grid.Row="0" VerticalAlignment="Bottom"
                Height="1" Background="{DynamicResource ThemeSeparator}"/>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  ROW 1 — Content: Left sidebar | Main column    -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="220, *">

            <!-- ─── LEFT SIDEBAR ─── -->
            <Grid Grid.Column="0"
                  Background="{DynamicResource ThemeLeftPanelBg}"
                  RowDefinitions="Auto, *">

                <!-- Navigation -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource ThemeSeparator}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <Button x:Name="FileModeButton"
                                Classes="navBtn batchActive"
                                Click="OnFileModeButtonClicked">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="▤" FontSize="14" Foreground="#4a4e7a"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Files" VerticalAlignment="Center"
                                           FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BatchModeToggle"
                                Classes="navBtn"
                                Click="OnBatchModeToggleClicked">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="⊞" FontSize="14" Foreground="#4a4e7a"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Batch" VerticalAlignment="Center"
                                           FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HistoryToggle"
                                Classes="navBtn"
                                Click="OnHistoryToggleClicked">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="◷" FontSize="14" Foreground="#4a4e7a"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="History" VerticalAlignment="Center"
                                           FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Panel overlay: one visible at a time -->
                <Grid Grid.Row="1">

                    <!-- ── SINGLE FILE PANEL ── -->
                    <Grid x:Name="SingleFilePanel"
                          RowDefinitions="160, 3, *"
                          IsVisible="True">

                        <!-- Preview (first Border child — used as secondary DragDrop target) -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource ThemeWindowBg}"
                                BorderBrush="{DynamicResource ThemeSeparator}" BorderThickness="0,0,0,1"
                                ClipToBounds="True"
                                DragDrop.AllowDrop="True">
                            <Panel>
                                <Image x:Name="SelectedImage"
                                       Stretch="Uniform"
                                       PointerPressed="OpenEnlargedImage"
                                       Cursor="Hand"/>
                                <TextBlock x:Name="PreviewPlaceholder"
                                           Text="♪" FontSize="48"
                                           Foreground="#14162e"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource NunitoFont}"
                                           IsVisible="False"/>
                                <Border x:Name="VideoPreviewBadge"
                                        IsVisible="False"
                                        Background="#bb000018" CornerRadius="4"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="8" Padding="6,2">
                                    <TextBlock Text="VIDEO PREVIEW"
                                               Foreground="#383c68" FontSize="8" FontWeight="Bold"
                                               LetterSpacing="1"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                </Border>
                                <Border x:Name="PreviewClickHint"
                                        IsVisible="False"
                                        Background="#80000010"
                                        IsHitTestVisible="False">
                                    <TextBlock Text="Click to enlarge"
                                               Foreground="#40426a" FontSize="9"
                                               FontFamily="{StaticResource NunitoFont}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,8"/>
                                </Border>
                            </Panel>
                        </Border>

                        <!-- Loading bar -->
                        <ProgressBar Grid.Row="1"
                                     x:Name="PreviewLoadingBar"
                                     IsIndeterminate="False"
                                     Minimum="0" Maximum="100" Value="0"
                                     IsVisible="False" Height="3"
                                     Foreground="{DynamicResource ThemeAccent}"
                                     Background="{DynamicResource ThemeWindowBg}"/>

                        <!-- Scrollable metadata -->
                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,12,16,16">

                                <TextBlock Text="FILE" Classes="sectionHdr" Margin="0,0,0,8"/>

                                <Grid ColumnDefinitions="86, *" Margin="0,0,0,5">
                                    <TextBlock Grid.Column="0" Text="NAME"  Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaFileName" Classes="metaVal" Text="—"/>
                                </Grid>
                                <Grid ColumnDefinitions="86, *" Margin="0,0,0,5">
                                    <TextBlock Grid.Column="0" Text="TYPE"  Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaFileType" Classes="metaVal" Text="—"/>
                                </Grid>
                                <Grid ColumnDefinitions="86, *" Margin="0,0,0,12">
                                    <TextBlock Grid.Column="0" Text="SIZE"  Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaFileSize" Classes="metaVal" Text="—"/>
                                </Grid>

                                <TextBlock x:Name="MediaInfoHeader"
                                           Text="MEDIA" Classes="sectionHdr"
                                           Margin="0,0,0,8" IsVisible="False"/>

                                <Grid x:Name="RowResolution"  ColumnDefinitions="86, *" Margin="0,0,0,5" IsVisible="False">
                                    <TextBlock Grid.Column="0" Text="RESOLUTION"  Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaResolution"  Classes="metaVal"/>
                                </Grid>
                                <Grid x:Name="RowColorSpace"  ColumnDefinitions="86, *" Margin="0,0,0,5" IsVisible="False">
                                    <TextBlock Grid.Column="0" Text="COLOR"       Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaColorSpace"  Classes="metaVal"/>
                                </Grid>
                                <Grid x:Name="RowBitDepth"    ColumnDefinitions="86, *" Margin="0,0,0,5" IsVisible="False">
                                    <TextBlock Grid.Column="0" Text="BIT DEPTH"   Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaBitDepth"    Classes="metaVal"/>
                                </Grid>
                                <Grid x:Name="RowDuration"    ColumnDefinitions="86, *" Margin="0,0,0,5" IsVisible="False">
                                    <TextBlock Grid.Column="0" Text="DURATION"    Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaDuration"    Classes="metaVal"/>
                                </Grid>
                                <Grid x:Name="RowFPS"         ColumnDefinitions="86, *" Margin="0,0,0,5" IsVisible="False">
                                    <TextBlock Grid.Column="0" Text="FPS"         Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaFPS"         Classes="metaVal"/>
                                </Grid>
                                <Grid x:Name="RowBitrate"     ColumnDefinitions="86, *" Margin="0,0,0,5" IsVisible="False">
                                    <TextBlock Grid.Column="0" Text="BITRATE"     Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaBitrate"     Classes="metaVal"/>
                                </Grid>
                                <Grid x:Name="RowSampleRate"  ColumnDefinitions="86, *" Margin="0,0,0,5" IsVisible="False">
                                    <TextBlock Grid.Column="0" Text="SAMPLE RATE" Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaSampleRate"  Classes="metaVal"/>
                                </Grid>
                                <Grid x:Name="RowChannels"    ColumnDefinitions="86, *" Margin="0,0,0,5" IsVisible="False">
                                    <TextBlock Grid.Column="0" Text="CHANNELS"    Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaChannels"    Classes="metaVal"/>
                                </Grid>
                                <Grid x:Name="RowVCodec"      ColumnDefinitions="86, *" Margin="0,0,0,5" IsVisible="False">
                                    <TextBlock Grid.Column="0" Text="V.CODEC"     Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaVCodec"      Classes="metaVal"/>
                                </Grid>
                                <Grid x:Name="RowACodec"      ColumnDefinitions="86, *" Margin="0,0,0,5" IsVisible="False">
                                    <TextBlock Grid.Column="0" Text="A.CODEC"     Classes="metaKey"/>
                                    <TextBlock Grid.Column="1" x:Name="MetaACodec"      Classes="metaVal"/>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ── HISTORY PANEL ── -->
                    <Grid x:Name="HistoryPanel" RowDefinitions="Auto, *" IsVisible="False">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="14,10,14,8">
                            <TextBlock Grid.Column="0" Text="HISTORY"
                                       Classes="sectionHdr" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Clear all"
                                    Classes="miniBtn" Height="24" Padding="10,0" FontSize="10"
                                    Click="OnHistoryClearClicked"/>
                        </Grid>
                        <ListBox Grid.Row="1"
                                 x:Name="HistoryListBox"
                                 Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding ConversionHistory}"
                                 PointerPressed="OnHistoryItemClicked">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ConversionHistoryEntry">
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding DisplayLine}"
                                                   Foreground="#60669a" FontSize="11"
                                                   FontFamily="{StaticResource NunitoFont}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding SizeLine}"
                                                       Foreground="#252848" FontSize="9"
                                                       FontFamily="{StaticResource NunitoFont}"/>
                                            <TextBlock Text="{Binding TimeLine}"
                                                       Foreground="#1c1f40" FontSize="9"
                                                       FontFamily="{StaticResource NunitoFont}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- ── BATCH PANEL ── -->
                    <Grid x:Name="BatchPanel" RowDefinitions="Auto, *, Auto" IsVisible="False">

                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto" Margin="14,10,14,8">
                            <TextBlock Grid.Column="0"
                                       x:Name="BatchHeaderLabel"
                                       Text="BATCH QUEUE (0)"
                                       Classes="sectionHdr" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Done"
                                    Classes="miniBtn" Height="24" Padding="8,0" FontSize="10"
                                    Click="OnBatchClearDoneClicked" Margin="0,0,4,0"
                                    ToolTip.Tip="Remove completed / errored items"/>
                            <Button Grid.Column="2" Content="+ Add"
                                    Classes="miniBtn" Height="24" Padding="8,0" FontSize="10"
                                    Click="OnBatchAddFilesClicked" Margin="0,0,4,0"/>
                            <Button Grid.Column="3" Content="Clear"
                                    Classes="miniBtn" Height="24" Padding="8,0" FontSize="10"
                                    Click="OnBatchClearClicked"/>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 x:Name="BatchQueueList"
                                 Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding BatchQueue}"
                                 KeyDown="OnBatchListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:BatchFileItem">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,1">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Status, Converter={x:Static local:MainWindow.StatusToSymbol}}"
                                                   Foreground="{Binding Status, Converter={x:Static local:MainWindow.StatusToColor}}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FileName}"
                                                   Foreground="#60669a" FontSize="11"
                                                   FontFamily="{StaticResource NunitoFont}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusText}"
                                                   Foreground="{Binding Status, Converter={x:Static local:MainWindow.StatusToColor}}"
                                                   FontSize="9" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoFont}"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                        <Button Grid.Column="3"
                                                Content="✕"
                                                Click="OnBatchItemRemoveClicked"
                                                Background="Transparent"
                                                Foreground="#20234a"
                                                BorderThickness="0"
                                                Width="22" Height="22"
                                                Padding="0" FontSize="10"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                FontFamily="{StaticResource NunitoFont}"
                                                ToolTip.Tip="Remove (Del)"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="14,6,14,14">
                            <TextBlock x:Name="BatchProgressText"
                                       Text="No files queued"
                                       Foreground="#20234a" FontSize="10"
                                       FontFamily="{StaticResource NunitoFont}"
                                       Margin="0,0,0,6"/>
                            <ProgressBar x:Name="BatchProgressBar"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="3" IsVisible="False"
                                         Foreground="{DynamicResource ThemeAccent}"
                                         Background="{DynamicResource ThemeInputBg}"/>
                        </StackPanel>
                    </Grid>

                </Grid>

                <!-- Right-edge separator -->
                <Border Grid.RowSpan="2"
                        HorizontalAlignment="Right" Width="1"
                        Background="{DynamicResource ThemeSeparator}"/>
            </Grid>

            <!-- ─── MAIN COLUMN ─── -->
            <Grid Grid.Column="1"
                  Background="{DynamicResource ThemeRightPanelBg}"
                  RowDefinitions="Auto, Auto, *">

                <!-- DROP ZONE (Row 0) -->
                <Border Grid.Row="0"
                        x:Name="InputFileBorder"
                        Background="{DynamicResource ThemeInputBg}"
                        BorderBrush="{DynamicResource ThemeInputBorder}"
                        BorderThickness="2"
                        CornerRadius="12"
                        Margin="14,14,14,0"
                        MinHeight="130"
                        DragDrop.AllowDrop="True">
                    <Panel>

                        <!-- Empty state -->
                        <StackPanel x:Name="DropZoneEmptyHint"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="4" IsHitTestVisible="False">
                            <TextBlock Text="⬇" FontSize="30"
                                       HorizontalAlignment="Center"
                                       Foreground="#282c5e"/>
                            <TextBlock Text="Drop Zone"
                                       FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="#2e3268"
                                       FontFamily="{StaticResource NunitoFont}"/>
                            <TextBlock Text="Drag &amp; Drop Files Here"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="#1e2148"
                                       FontFamily="{StaticResource NunitoFont}"/>
                        </StackPanel>

                        <!-- File loaded state -->
                        <StackPanel x:Name="DropZoneFileDisplay"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsVisible="False"
                                    Spacing="10">
                            <TextBlock x:Name="SelectedFileNameDisplay"
                                       FontSize="13"
                                       Foreground="#3a3e6a"
                                       FontFamily="{StaticResource NunitoFont}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="460"/>
                            <Button x:Name="ClearFileButton"
                                    Content="✕"
                                    Click="OnClearFileClicked"
                                    IsVisible="False"
                                    Classes="miniBtn"
                                    Width="28" Height="28"
                                    Padding="0" FontSize="11"
                                    ToolTip.Tip="Clear file (Esc)"/>
                        </StackPanel>

                        <!-- Browse button (always visible) -->
                        <Button Content="Browse…"
                                Click="OnSelectFileButtonClicked"
                                Classes="miniBtn"
                                Height="28" Padding="14,0" FontSize="11"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Margin="0,0,12,10"
                                ToolTip.Tip="Open file (Ctrl+O)"/>

                        <!-- Drag overlay -->
                        <Border x:Name="DragHintOverlay"
                                IsVisible="False"
                                Background="#d0070714"
                                BorderBrush="{DynamicResource ThemeAccent}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                IsHitTestVisible="False">
                            <TextBlock Text="Drop to load"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeAccentLight}"
                                       FontSize="13" FontWeight="Bold"
                                       LetterSpacing="1"
                                       FontFamily="{StaticResource NunitoFont}"/>
                        </Border>

                        <!-- File loading progress bar -->
                        <ProgressBar x:Name="FileLoadingBar"
                                     IsIndeterminate="False"
                                     Minimum="0" Maximum="100" Value="0"
                                     IsVisible="False" Height="2"
                                     VerticalAlignment="Bottom"
                                     Foreground="{DynamicResource ThemeAccent}"
                                     Background="Transparent"
                                     IsHitTestVisible="False"/>
                    </Panel>
                </Border>

                <!-- OUTPUT FORMAT (Row 1) -->
                <Border Grid.Row="1"
                        Classes="card"
                        Margin="14,10,14,0"
                        Padding="16,14">
                    <StackPanel>

                        <!-- Header -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0"
                                       Text="OUTPUT FORMAT"
                                       Classes="sectionHdr"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="ConversionArrowLabel"
                                       Foreground="#222548"
                                       FontSize="10" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoFont}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Three media type cards -->
                        <Grid ColumnDefinitions="*, 10, *, 10, *" Margin="0,0,0,12">

                            <Button Grid.Column="0"
                                    x:Name="TabImageButton"
                                    Classes="mediaCard mediaCardImage tabActive"
                                    Click="OnTabButtonClicked"
                                    Tag="0">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="▣" FontSize="22"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="IMAGE"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="PNG · JPG · WEBP"
                                               FontSize="9" Opacity="0.5"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    x:Name="TabAudioButton"
                                    Classes="mediaCard mediaCardAudio"
                                    Click="OnTabButtonClicked"
                                    Tag="1">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="♪" FontSize="22"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="AUDIO"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="MP3 · WAV · FLAC"
                                               FontSize="9" Opacity="0.5"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4"
                                    x:Name="TabVideoButton"
                                    Classes="mediaCard mediaCardVideo"
                                    Click="OnTabButtonClicked"
                                    Tag="2">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="20"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="VIDEO"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="MP4 · MOV · MKV"
                                               FontSize="9" Opacity="0.5"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                            </Button>

                        </Grid>

                        <!-- IMAGE format chips -->
                        <WrapPanel x:Name="ImageFormatPanel" Orientation="Horizontal">
                            <Button Classes="fmtChip fmtActive" Content="PNG"  Tag="PNG"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="JPG"  Tag="JPG"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="WEBP" Tag="WEBP" Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="GIF"  Tag="GIF"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="BMP"  Tag="BMP"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="TIFF" Tag="TIFF" Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="ICO"  Tag="ICO"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="AVIF" Tag="AVIF" Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="HEIC" Tag="HEIC" Click="OnFormatChipClicked"/>
                        </WrapPanel>

                        <!-- AUDIO format chips -->
                        <WrapPanel x:Name="AudioFormatPanel" Orientation="Horizontal" IsVisible="False">
                            <Button Classes="fmtChip fmtActive" Content="MP3"  Tag="MP3"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="WAV"  Tag="WAV"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="FLAC" Tag="FLAC" Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="OGG"  Tag="OGG"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="AAC"  Tag="AAC"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="M4A"  Tag="M4A"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="OPUS" Tag="OPUS" Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="AIFF" Tag="AIFF" Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="WMA"  Tag="WMA"  Click="OnFormatChipClicked"/>
                        </WrapPanel>

                        <!-- VIDEO format chips -->
                        <WrapPanel x:Name="VideoFormatPanel" Orientation="Horizontal" IsVisible="False">
                            <Button Classes="fmtChip fmtActive" Content="MP4"  Tag="MP4"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="MOV"  Tag="MOV"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="AVI"  Tag="AVI"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="MKV"  Tag="MKV"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="WEBM" Tag="WEBM" Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="FLV"  Tag="FLV"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="WMV"  Tag="WMV"  Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="TS"   Tag="TS"   Click="OnFormatChipClicked"/>
                            <Button Classes="fmtChip"           Content="GIF"  Tag="GIF"  Click="OnFormatChipClicked"/>
                        </WrapPanel>

                    </StackPanel>
                </Border>

                <!-- OPTIONS (Row 2) -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Classes="card"
                            Margin="14,10,14,14"
                            Padding="16,14"
                            VerticalAlignment="Top">
                        <StackPanel>

                            <TextBlock Text="OPTIONS"
                                       Classes="sectionHdr"
                                       Margin="0,0,0,14"/>

                            <!-- Quality -->
                            <Grid ColumnDefinitions="86, *, Auto" Margin="0,0,0,14">
                                <TextBlock Grid.Column="0"
                                           Text="Quality"
                                           Foreground="#3a3e68"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource NunitoFont}"/>
                                <Slider Grid.Column="1"
                                        x:Name="QualitySlider"
                                        Minimum="0" Maximum="100" Value="80"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        VerticalAlignment="Center"
                                        Margin="10,0"/>
                                <Border Grid.Column="2"
                                        Background="{DynamicResource ThemeInputBg}"
                                        CornerRadius="6"
                                        BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1"
                                        Padding="8,3" Width="44"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding #QualitySlider.Value, StringFormat={}{0:0}}"
                                               Foreground="#666a98"
                                               FontSize="11" FontWeight="Bold"
                                               TextAlignment="Center"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                </Border>
                            </Grid>

                            <!-- Resolution -->
                            <StackPanel x:Name="ResolutionPanel" Margin="0,0,0,14">
                                <Grid ColumnDefinitions="86, *, Auto, Auto, *, Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="Resolution"
                                               Foreground="#3a3e68"
                                               FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="ResolutionWidthInput"
                                             Watermark="W" Height="30"
                                             VerticalAlignment="Center"
                                             Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}"
                                             TextChanged="OnResolutionInputTextChanged"/>
                                    <TextBlock Grid.Column="2"
                                               Text="×"
                                               Foreground="#202344" FontSize="14"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Margin="8,0"/>
                                    <Button Grid.Column="3"
                                            x:Name="AspectRatioLockButton"
                                            Content="AR"
                                            Click="OnAspectRatioLockClicked"
                                            Background="{DynamicResource ThemeInputBg}"
                                            Foreground="#28305a"
                                            BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1"
                                            CornerRadius="5"
                                            Height="24" Padding="5,0"
                                            FontSize="9" FontWeight="Bold"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            FontFamily="{StaticResource NunitoFont}"
                                            ToolTip.Tip="Lock aspect ratio"/>
                                    <TextBox Grid.Column="4"
                                             x:Name="ResolutionHeightInput"
                                             Watermark="H" Height="30"
                                             VerticalAlignment="Center"
                                             Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}"
                                             TextChanged="OnResolutionInputTextChanged"/>
                                    <TextBlock Grid.Column="5"
                                               x:Name="OriginalResolutionHint"
                                               Foreground="#18193a" FontSize="9"
                                               FontFamily="{StaticResource NunitoFont}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               TextWrapping="Wrap" MaxWidth="60"/>
                                </Grid>
                            </StackPanel>

                            <!-- Trim -->
                            <StackPanel x:Name="TrimPanel" IsVisible="False" Margin="0,0,0,14">
                                <Grid ColumnDefinitions="86, *, Auto, *, Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="Trim"
                                               Foreground="#3a3e68"
                                               FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="TrimStartInput"
                                             Watermark="start" Height="30"
                                             VerticalAlignment="Center"
                                             Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}"
                                             ToolTip.Tip="Start time (hh:mm:ss or seconds)"
                                             TextChanged="OnTrimInputChanged"/>
                                    <TextBlock Grid.Column="2"
                                               Text="→"
                                               Foreground="#202344" FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Margin="8,0"/>
                                    <TextBox Grid.Column="3"
                                             x:Name="TrimEndInput"
                                             Watermark="end" Height="30"
                                             VerticalAlignment="Center"
                                             Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}"
                                             ToolTip.Tip="End time (hh:mm:ss or seconds)"
                                             TextChanged="OnTrimInputChanged"/>
                                    <TextBlock Grid.Column="4"
                                               Text="hh:mm:ss"
                                               Foreground="#161830" FontSize="9"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Audio → Video background -->
                            <StackPanel x:Name="AudioToVideoPanel" IsVisible="False">
                                <TextBlock Text="BACKGROUND" Classes="sectionHdr" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="ATVColorChip"
                                            Content="Solid Color"
                                            Classes="fmtChip fmtActive"
                                            Tag="color" Height="26" Padding="10,0"
                                            Click="OnATVModeClicked"/>
                                    <Button x:Name="ATVImageChip"
                                            Content="Use Image"
                                            Classes="fmtChip"
                                            Tag="image" Height="26" Padding="10,0"
                                            Click="OnATVModeClicked"/>
                                </StackPanel>
                                <Grid x:Name="ATVColorRow" ColumnDefinitions="Auto, Auto, *">
                                    <Border Grid.Column="0"
                                            x:Name="ATVColorPreview"
                                            Width="28" Height="28" CornerRadius="6"
                                            Background="{DynamicResource ThemeInputBg}"
                                            BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1"
                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="#" Foreground="#272a50" FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0"
                                               FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBox Grid.Column="2"
                                             x:Name="ATVColorBox"
                                             Text="1a1a1a" Watermark="rrggbb"
                                             Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}"
                                             Height="28"
                                             TextChanged="OnATVColorChanged"/>
                                </Grid>
                                <Grid x:Name="ATVImageRow" ColumnDefinitions="*, Auto" IsVisible="False">
                                    <TextBox Grid.Column="0"
                                             x:Name="ATVImagePathBox"
                                             Watermark="Background image path…"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}"
                                             Height="28"/>
                                    <Button Grid.Column="1"
                                            Content="Browse…"
                                            Classes="miniBtn"
                                            Height="28" Padding="12,0"
                                            Margin="6,0,0,0"
                                            Click="OnATVImageBrowseClicked"/>
                                </Grid>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  ROW 2 — Footer                                 -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="2"
              Background="{DynamicResource ThemeHeaderBg}"
              ColumnDefinitions="Auto, *, Auto, Auto, Auto">

            <Border Grid.ColumnSpan="5"
                    VerticalAlignment="Top" Height="1"
                    Background="{DynamicResource ThemeSeparator}"/>

            <!-- Left: output actions -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0" Spacing="6">
                <Button x:Name="OutputButton"
                        Content="Open Output"
                        IsEnabled="False"
                        Command="{Binding OpenLastOutputFolderCommand}"
                        Classes="miniBtn"
                        Height="34" Padding="16,0" FontSize="11"/>
                <Button x:Name="CopyPathButton"
                        Content="Copy Path"
                        IsEnabled="False" IsVisible="False"
                        Click="OnCopyPathClicked"
                        Classes="miniBtn"
                        Height="34" Padding="14,0" FontSize="11"
                        ToolTip.Tip="Copy output file path to clipboard"/>
            </StackPanel>

            <!-- Center: status + progress + keyboard hints -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="3">
                <TextBlock x:Name="OutputPreviewText"
                           Foreground="#1c1f40" FontSize="10"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource NunitoFont}"/>
                <TextBlock x:Name="ErrorText"
                           Foreground="#e04040" FontSize="11"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource NunitoFont}"/>
                <TextBlock x:Name="ConversionPercentText"
                           Foreground="#464a78" FontSize="10"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource NunitoFont}"
                           IsVisible="False"/>
                <ProgressBar x:Name="ConversionProgress"
                             IsIndeterminate="True" IsVisible="False"
                             Height="2" Width="200"
                             Foreground="{DynamicResource ThemeAccent}"
                             Background="Transparent"/>
                <TextBlock x:Name="KeyboardHints"
                           Text="Enter · Convert   Esc · Clear   Ctrl+O · Open"
                           Foreground="#16182e" FontSize="9"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource NunitoFont}"/>
            </StackPanel>

            <!-- Cancel -->
            <Button Grid.Column="2"
                    x:Name="CancelButton"
                    Content="Cancel"
                    IsVisible="False"
                    Click="OnCancelClicked"
                    Background="#160a12" Foreground="#e04040"
                    BorderBrush="#360e1a" BorderThickness="1"
                    CornerRadius="8"
                    Height="36" Padding="22,0"
                    FontSize="12" FontWeight="Bold"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="0,0,8,0"
                    FontFamily="{StaticResource NunitoFont}"
                    ToolTip.Tip="Cancel conversion"/>

            <!-- Convert (single) — green -->
            <Button Grid.Column="3"
                    x:Name="GenerateButton"
                    Content="▶  Convert"
                    IsEnabled="False" IsVisible="True"
                    Click="OnGenerateButtonClicked"
                    Background="#16a34a" Foreground="#f0fff4"
                    BorderBrush="#22c55e" BorderThickness="0,1,0,0"
                    CornerRadius="8"
                    Height="36" Padding="26,0"
                    FontSize="12" FontWeight="Bold"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="0,0,8,0"
                    FontFamily="{StaticResource NunitoFont}"
                    ToolTip.Tip="Convert (Enter)"/>

            <!-- Convert All (batch) — green -->
            <Button Grid.Column="4"
                    x:Name="BatchConvertButton"
                    Content="▶  Convert All"
                    IsEnabled="False" IsVisible="False"
                    Click="OnBatchConvertClicked"
                    Background="#16a34a" Foreground="#f0fff4"
                    BorderBrush="#22c55e" BorderThickness="0,1,0,0"
                    CornerRadius="8"
                    Height="36" Padding="26,0"
                    FontSize="12" FontWeight="Bold"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="0,0,14,0"
                    FontFamily="{StaticResource NunitoFont}"/>

        </Grid>

    </Grid>
</Window>
